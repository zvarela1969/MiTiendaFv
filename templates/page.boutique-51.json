riencia íntima y personalizada que refleja la esencia del universo Felipe Varela.<br\/><br\/>Un lugar donde la moda trasciende la tendencia para convertirse en arte, pensado para quienes entienden que la verdadera exclusividad se encuentra en lo hecho a medida.<\/p>"}}},"block_order":["heading_aE9PWr","richtext_JfCgcq"],"custom_css":[".prose{max-width: 924px; margin: 0 auto;}"],"name":"t:sections.rich_text.presets.rich_text.name","settings":{"separate_section_with_border":true,"content_width":"sm","text_position":"center","remove_vertical_spacing":false}},"multi_column_Qe7rmK":{"type":"multi-column","blocks":{"image_with_text_QTabWd":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/Frame_360.png","title":"","heading_tag":"h3","content":"","link_url":"","link_text":""}},"image_with_text_bnxiVf":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/Frame_357_1776b1d5-8e9f-4d22-8200-0fccda9f9c30.png","title":"","heading_tag":"h3","content":"","link_url":"","link_text":""}},"image_with_text_Nw9Tte":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/Frame_359.png","title":"","heading_tag":"h3","content":"","link_url":"","link_text":""}},"image_with_text_PAPjn4":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/Frame_358.png","title":"","heading_tag":"h3","content":"","link_url":"","link_text":""}}},"block_order":["image_with_text_QTabWd","image_with_text_bnxiVf","image_with_text_Nw9Tte","image_with_text_PAPjn4"],"name":"t:sections.multi_column.presets.multi_column.name","settings":{"separate_section_with_border":false,"columns_per_row":4,"stack_on_mobile":true,"overlap_image":false,"content_alignment":"start","text_alignment":"start","spacing":"xs","subheading":"","title":"","content":""}},"rich_text_pjDYbg":{"type":"rich-text","blocks":{"button_mFyqTG":{"type":"button","settings":{"style":"solid","text":"Solicitar una cita","url":"","background":"","text_color":""}}},"block_order":["butt